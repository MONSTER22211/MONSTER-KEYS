{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/app.py",
      "/Dockerfile",
      "/requirements.txt",
      "/keygen.py",
      "/.dockerignore",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:5050 --workers 4 --threads 2 --timeout 120 --graceful-timeout 30 --keep-alive 5 --access-logfile - --error-logfile - --log-level info app:app",
    "healthcheckPath": "/api/app/health",
    "healthcheckPort": 5050,
    "healthcheckTimeout": 10000,
    "healthcheckInterval": 30000,
    "healthcheckInitialDelay": 15000,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 20,
    "sleepApplication": false,
    "replicas": 1
  }
}
